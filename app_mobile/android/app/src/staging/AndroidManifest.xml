<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="remove" />
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="com.google.android.c2dm.permission.RECEIVE"
        tools:node="remove" />

    <application
        android:icon="@mipmap/ic_launcher_staging"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_staging_round"
        android:usesCleartextTraffic="false"
        tools:replace="android:icon,android:label,android:roundIcon">
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            tools:node="remove" />

        <service
            android:name=".core.notifications.IA4TubeFirebaseMessagingService"
            tools:node="remove" />
        <service
            android:name="com.google.firebase.messaging.FirebaseMessagingService"
            tools:node="remove" />
        <receiver
            android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver"
            tools:node="remove" />
    </application>

</manifest>
