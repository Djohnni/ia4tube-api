+      const byteCounter = { size: 0 };
+      try {
+        await pipeline(
+          stream,
+          hashPassThrough(hash, byteCounter),
+          fileSystem.createWriteStream(destination, {
+            flags: "wx",
+            mode: 0o600
+          })
