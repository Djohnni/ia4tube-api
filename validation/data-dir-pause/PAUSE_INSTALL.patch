+      // owner can retry absence+barrier; another process cannot remove/adopt it.
+      await barrier();
+      owned.bytes.fill(0);
+      owned = null;
+      removed = false;
+    } catch (_) { fail(); }
+  }
+  return Object.freeze({ acquire, release, held: () => owned !== null });
+}
+
+module.exports = { assertNoUnfinishedPause, createPauseMarker, MARKER_NAME };
