+    }
+    await ingestion;
+  } catch (error) {
+    entryFailure =
+      error instanceof EncryptedBackupBundleError
+        ? error
+        : new EncryptedBackupBundleError(
+            transforms.length > 0
+              ? "backup_bundle_authentication_failed"
+              : "backup_bundle_extraction_failed"
+          );
